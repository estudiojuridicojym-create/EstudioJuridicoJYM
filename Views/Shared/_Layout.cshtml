<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Estudio Jurídico JYM</title>
    <link rel="icon" type="image/webp" href="~/img/logo.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Raleway:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/app.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <div class="app-shell">
        <div class="sidebar-backdrop" id="sidebar-backdrop"></div>
        <aside class="sidebar" id="sidebar">
            <div class="logo">
                <div class="logo-badge"><img src="~/img/logo-white.png" alt="Estudio Jurídico JYM" /></div>
            </div>
            <nav id="nav-lateral">
                <a class="item" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Inicio</a>
                <a class="item" href="/app/clientes"><i class="bi bi-people"></i> Clientes</a>
                <a class="item" href="/app/procesos"><i class="bi bi-briefcase"></i> Procesos</a>
                <a class="item" href="/app/pagos"><i class="bi bi-cash-coin"></i> Pagos</a>
                @if (User.IsInRole("ABOGADO"))
                {
                    var pendientes = ViewData["SolicitudesPendientes"] as int? ?? 0;
                    <a class="item" href="/app/solicitudes">
                        <i class="bi bi-check2-square"></i> Solicitudes de cambio
                        @if (pendientes > 0)
                        {
                            <span class="contador-menu">@pendientes</span>
                        }
                    </a>
                }
                <a class="item" href="/app/agenda"><i class="bi bi-calendar3"></i> Agenda</a>
                <a class="item" href="/app/mensajes"><i class="bi bi-chat-dots"></i> Mensajes</a>
                <a class="item" href="/app/notificaciones"><i class="bi bi-bell"></i> Notificaciones</a>
                @if (User.IsInRole("ABOGADO"))
                {
                    <a class="item" href="/app/registro-actividades"><i class="bi bi-clock-history"></i> Registro de actividades</a>
                    <a class="item" href="/app/usuarios"><i class="bi bi-people"></i> Usuarios</a>
                }
                <a class="item" href="/app/mi-perfil"><i class="bi bi-person-circle"></i> Mi perfil</a>
            </nav>
            <div class="logout">
                <form method="post" asp-controller="Auth" asp-action="Logout">
                    @Html.AntiForgeryToken()
                    <button type="submit"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</button>
                </form>
            </div>
        </aside>

        <div class="main-area">
            <header class="topbar">
                <div class="topbar-izq">
                    <button type="button" class="menu-toggle" id="menu-toggle" aria-label="Abrir menú" aria-controls="sidebar" aria-expanded="false">
                        <i class="bi bi-list"></i>
                    </button>
                    <span class="titulo-pagina">@ViewData["Title"]</span>
                </div>
                <div class="usuario-info">
                    <a class="campana" href="/app/notificaciones">
                        <i class="bi bi-bell"></i>
                        @{
                            var noLeidas = ViewData["NotificacionesNoLeidas"] as int? ?? 0;
                        }
                        @if (noLeidas > 0)
                        {
                            <span class="contador">@noLeidas</span>
                        }
                    </a>
                    <span>
                        <span class="nombre">@(User?.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value)</span>
                    </span>
                </div>
            </header>
            <div class="content">
                @RenderBody()
            </div>
        </div>
    </div>

    <script>
        (function () {
            var ruta = window.location.pathname;
            var enlaces = document.querySelectorAll('#nav-lateral a.item');
            var mejor = null;
            enlaces.forEach(function (a) {
                var href = a.getAttribute('href');
                if (href && ruta.indexOf(href) === 0) {
                    if (!mejor || href.length > mejor.getAttribute('href').length) {
                        mejor = a;
                    }
                }
            });
            if (mejor) { mejor.classList.add('activo'); }
        })();

        (function () {
            var sidebar = document.getElementById('sidebar');
            var toggle = document.getElementById('menu-toggle');
            var backdrop = document.getElementById('sidebar-backdrop');
            if (!sidebar || !toggle || !backdrop) return;

            function abrir() {
                sidebar.classList.add('abierto');
                backdrop.classList.add('visible');
                toggle.setAttribute('aria-expanded', 'true');
                document.body.classList.add('bloqueo-scroll');
            }
            function cerrar() {
                sidebar.classList.remove('abierto');
                backdrop.classList.remove('visible');
                toggle.setAttribute('aria-expanded', 'false');
                document.body.classList.remove('bloqueo-scroll');
            }

            toggle.addEventListener('click', function () {
                sidebar.classList.contains('abierto') ? cerrar() : abrir();
            });
            backdrop.addEventListener('click', cerrar);
            document.querySelectorAll('#nav-lateral a.item').forEach(function (a) {
                a.addEventListener('click', cerrar);
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') cerrar();
            });
            window.addEventListener('resize', function () {
                if (window.innerWidth > 992) cerrar();
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
