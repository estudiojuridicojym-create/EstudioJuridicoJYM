@model DashboardJym.Models.ViewModels.OlvidoPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Recuperar contraseña";
    bool correoEnviado = (bool)(ViewData["CorreoEnviado"] ?? false);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recuperar contraseña - Estudio Jurídico JYM</title>
    <link rel="icon" type="image/webp" href="~/img/logo.webp">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Raleway:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/app.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <div class="login-wrap">
        <div class="login-panel-brand">
            <h2>Panel interno de <span class="accent">gestión legal</span></h2>
            <p>Accede para administrar clientes, procesos, pagos y agenda del estudio de forma centralizada y segura.</p>
            <ul>
                <li><i class="bi bi-shield-check"></i> Acceso exclusivo para abogados y asesores</li>
                <li><i class="bi bi-briefcase"></i> Seguimiento de procesos y clientes en un solo lugar</li>
                <li><i class="bi bi-clock-history"></i> Registro de actividad y auditoría interna</li>
            </ul>
        </div>

        <div class="login-panel-form">
            <div class="login-caja">
                @if (correoEnviado)
                {
                    <h1>Revisa tu correo</h1>
                    <p class="sub">Si el correo ingresado está registrado, te enviamos un enlace para crear una nueva contraseña. Vence en 30 minutos.</p>

                    <div class="mensaje"><i class="bi bi-envelope-check"></i> Solicitud enviada correctamente.</div>

                    <p style="text-align:center; margin-top:20px; font-size:12.5px;">
                        <a asp-controller="Auth" asp-action="Login">Volver a iniciar sesión</a>
                    </p>
                }
                else
                {
                    <h1>Recuperar contraseña</h1>
                    <p class="sub">Ingresa tu correo y te enviaremos un enlace para crear una nueva contraseña.</p>

                    <form method="post" asp-controller="Auth" asp-action="OlvidePassword">
                        @Html.AntiForgeryToken()
                        <div class="campo" style="margin-bottom:16px;">
                            <label asp-for="Correo">Correo</label>
                            <input asp-for="Correo" type="email" required autofocus>
                            <span asp-validation-for="Correo" class="text-danger" style="font-size:12px;"></span>
                        </div>

                        <button type="submit" class="btn btn-primario"><i class="bi bi-send"></i> Enviar enlace de recuperación</button>
                    </form>

                    <p style="text-align:center; margin-top:20px; font-size:12.5px;">
                        <a asp-controller="Auth" asp-action="Login">Volver a iniciar sesión</a>
                    </p>
                }
            </div>
        </div>
    </div>
</body>
</html>
