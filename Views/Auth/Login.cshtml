@model DashboardJym.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar sesión";
    bool registrado = (bool)(ViewData["Registrado"] ?? false);
    bool error = (bool)(ViewData["Error"] ?? false);
    bool passwordRestablecida = (bool)(ViewData["PasswordRestablecida"] ?? false);
    int minutosBloqueo = (int)(ViewData["MinutosBloqueo"] ?? 0);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar sesión - Estudio Jurídico JYM</title>
    <link rel="icon" type="image/webp" href="~/img/logo.webp">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Raleway:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/app.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <div class="login-wrap">
        <div class="login-panel-brand">
            <h2>Panel interno de <span class="accent">gestión legal</span></h2>
            <p>Accede para administrar clientes, procesos, pagos y agenda del estudio de forma centralizada y segura.</p>
            <ul>
                <li><i class="bi bi-shield-check"></i> Acceso exclusivo para abogados y asesores</li>
                <li><i class="bi bi-briefcase"></i> Seguimiento de procesos y clientes en un solo lugar</li>
                <li><i class="bi bi-clock-history"></i> Registro de actividad y auditoría interna</li>
            </ul>
        </div>

        <div class="login-panel-form">
            <div class="login-caja">
                <h1>Iniciar sesión</h1>
                <p class="sub">Acceso para abogados y asesores legales</p>

                @if (registrado)
                {
                    <div class="mensaje">Cuenta creada correctamente. Ya puedes iniciar sesión.</div>
                }
                @if (passwordRestablecida)
                {
                    <div class="mensaje">Contraseña actualizada correctamente. Ya puedes iniciar sesión.</div>
                }
                @if (error)
                {
                    <div class="error">Correo o contraseña incorrectos.</div>
                }
                @if (minutosBloqueo > 0)
                {
                    <div class="error">
                        Demasiados intentos fallidos. Por seguridad, esta cuenta queda bloqueada
                        por @minutosBloqueo @(minutosBloqueo == 1 ? "minuto" : "minutos"). Vuelve a intentarlo después.
                    </div>
                }

                <form method="post" asp-controller="Auth" asp-action="Login">
                    @Html.AntiForgeryToken()
                    <div class="campo" style="margin-bottom:16px;">
                        <label asp-for="Correo">Correo</label>
                        <input asp-for="Correo" type="email" required autofocus>
                    </div>

                    <div class="campo">
                        <label asp-for="Password">Contraseña</label>
                        <div class="campo-password">
                            <input asp-for="Password" id="passwordInput" type="password" required>
                            <button type="button" class="toggle-password" onclick="togglePassword()" aria-label="Mostrar contraseña" tabindex="-1">
                                <i class="bi bi-eye" id="passwordIcon"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primario"><i class="bi bi-box-arrow-in-right"></i> Ingresar</button>
                </form>

                <p style="text-align:center; margin-top:16px; font-size:12.5px;">
                    <a asp-controller="Auth" asp-action="OlvidePassword">¿Olvidaste tu contraseña?</a>
                </p>
                <p style="text-align:center; margin-top:8px; font-size:12.5px;">
                    <a asp-controller="Auth" asp-action="Registro">¿No tienes cuenta? Regístrate</a>
                </p>
            </div>
        </div>
    </div>
    <script>
        function togglePassword() {
            const input = document.getElementById('passwordInput');
            const icon = document.getElementById('passwordIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
</body>
</html>
