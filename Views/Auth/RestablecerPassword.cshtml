@model DashboardJym.Models.ViewModels.RestablecerPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Crear nueva contraseña";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear nueva contraseña - Estudio Jurídico JYM</title>
    <link rel="icon" type="image/webp" href="~/img/logo.webp">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Raleway:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/app.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <div class="login-wrap">
        <div class="login-panel-brand">
            <h2>Panel interno de <span class="accent">gestión legal</span></h2>
            <p>Accede para administrar clientes, procesos, pagos y agenda del estudio de forma centralizada y segura.</p>
            <ul>
                <li><i class="bi bi-shield-check"></i> Acceso exclusivo para abogados y asesores</li>
                <li><i class="bi bi-briefcase"></i> Seguimiento de procesos y clientes en un solo lugar</li>
                <li><i class="bi bi-clock-history"></i> Registro de actividad y auditoría interna</li>
            </ul>
        </div>

        <div class="login-panel-form">
            <div class="login-caja">
                <h1>Crear nueva contraseña</h1>
                <p class="sub">Elige una contraseña nueva para tu cuenta.</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="error">Revisa los datos ingresados.</div>
                }

                <form method="post" asp-controller="Auth" asp-action="RestablecerPassword">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Token">

                    <div class="campo" style="margin-bottom:16px;">
                        <label asp-for="Password">Nueva contraseña</label>
                        <div class="campo-password">
                            <input asp-for="Password" id="passwordInput" type="password" required minlength="6" autofocus>
                            <button type="button" class="toggle-password" onclick="togglePassword('passwordInput','passwordIcon')" aria-label="Mostrar contraseña" tabindex="-1">
                                <i class="bi bi-eye" id="passwordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger" style="font-size:12px;"></span>
                    </div>

                    <div class="campo">
                        <label asp-for="ConfirmarPassword">Confirmar contraseña</label>
                        <div class="campo-password">
                            <input asp-for="ConfirmarPassword" id="confirmarInput" type="password" required minlength="6">
                            <button type="button" class="toggle-password" onclick="togglePassword('confirmarInput','confirmarIcon')" aria-label="Mostrar contraseña" tabindex="-1">
                                <i class="bi bi-eye" id="confirmarIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmarPassword" class="text-danger" style="font-size:12px;"></span>
                    </div>

                    <button type="submit" class="btn btn-primario" style="margin-top:16px;"><i class="bi bi-check2-circle"></i> Guardar nueva contraseña</button>
                </form>
            </div>
        </div>
    </div>
    <script>
        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
</body>
</html>
